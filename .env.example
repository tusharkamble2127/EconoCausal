# EconoCausal environment configuration
# Copy this file to .env and fill in values for your deployment.

# Environment mode: development (allows insecure default JWT secret) or production (requires secure secret)
ECONOCAUSAL_ENV=development

# JWT secret key. MUST be set to a secure, non-default value in production.
# The default "dev-only-insecure-secret-change-me" is only allowed when ECONOCAUSAL_ENV=development.
ECONOCAUSAL_JWT_SECRET=dev-only-insecure-secret-change-me

# JWT token expiration in minutes (default: 480 = 8 hours)
ECONOCAUSAL_JWT_EXPIRE_MINUTES=480

# Database URL (default: SQLite file relative to backend/)
ECONOCAUSAL_DB_URL=sqlite:///./econocausal.db

# CORS origins (comma-separated)
ECONOCAUSAL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Revenue per conversion assumption for KPI calculations
ECONOCAUSAL_REVENUE_PER_CONVERSION=100.0

# Brevo transactional email
ECONOCAUSAL_BREVO_API_KEY=your-brevo-api-key
ECONOCAUSAL_BREVO_TEMPLATE_ID=your-brevo-template-id

# SMTP configuration for password reset emails (optional for local development)
ECONOCAUSAL_SMTP_HOST=smtp.example.com
ECONOCAUSAL_SMTP_PORT=587
ECONOCAUSAL_SMTP_USERNAME=your-username
ECONOCAUSAL_SMTP_PASSWORD=your-password
ECONOCAUSAL_SMTP_FROM_EMAIL=noreply@example.com
ECONOCAUSAL_SMTP_USE_TLS=true

# Password reset settings
ECONOCAUSAL_PASSWORD_RESET_EXPIRE_MINUTES=30
ECONOCAUSAL_FRONTEND_BASE_URL=http://localhost:5173
