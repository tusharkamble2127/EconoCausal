# Python
__pycache__/
*.pyc
.venv/
venv/
.venv_py312/
*.egg-info/
.pytest_cache/

# Data (do not commit large or sensitive datasets; regenerated via data/generators)
data/raw/*.csv
data/processed/*.csv

# Local databases (SQLite; regenerated by the app on startup)
*.db

# Frontend
node_modules/
dist/
.vite/
playwright-report/
test-results/
.playwright-mcp/

# Environment (never commit secrets or local env overrides)
.env
.env.local
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Logs and generated artifacts
*.log

# Regenerable verification report outputs
scripts/verification/auth_persistence_verification_report.json
scripts/verification/browser_verification_report.json
scripts/verification/test_state.json

# Local runtime artifacts (regenerated at runtime; keep the empty dirs via .gitkeep)
artifacts/runtime-data/*
!artifacts/runtime-data/.gitkeep
artifacts/temporary/*
!artifacts/temporary/.gitkeep

# Generated validation report artifacts (regenerated by running scripts)
artifacts/definitive_validation/
artifacts/validation/

# Generated pipeline stage output logs
scripts/stage*_out.txt

# Generated backend test output logs
backend/test_results*.txt

# Temporary debug scripts
scripts/test_write*.py

# Temporary runner scripts and test output
run_integration_tests.bat
backend_integration_output.txt
